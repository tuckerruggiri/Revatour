{
  "functions": {
    "api/generate.js": {
      "maxDuration": 60
    },
    "api/quotes.js": {
      "maxDuration": 30
    },
    "api/quote.js": {
      "maxDuration": 60
    },
    "api/schwab/[action].js": {
      "maxDuration": 30
    },
    "api/discord.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}